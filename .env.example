# SIH26057 Marine Debris Intelligence - Frontend Configuration

# Base URL for the real FastAPI backend (e.g. http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Development / Mock Mode switch
# Set to 'true' for offline demonstration with synthetic sonar data
# Set to 'false' to communicate with live FastAPI inference service
VITE_USE_MOCK=true
